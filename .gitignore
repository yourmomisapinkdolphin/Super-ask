node_modules/
.next/
out/
build/
coverage/
next-env.d.ts
*.tsbuildinfo

# Secrets — never commit. R-15 / FR-74.
.env
.env.local
.env*.local

# Runtime audit + feedback logs (FR-55, FR-56). Contain query text.
var/
*.log

# Crawler output. data/crawl/verification.json is registry EVIDENCE and stays
# tracked; everything below is run state that a fresh crawl reproduces.
#
# data/crawl/raw/ is the FR-54 retention store — the raw bytes of every page
# fetched from every ministry, growing by thousands of files per weekly run.
# It belongs in the same domestic managed storage as the audit log under the
# NFR-11 residency policy, not in the git history of a public repository.
data/crawl/raw/
data/crawl/snapshots.json
data/crawl/review-queue.jsonl
data/crawl/last-report.json
# Written line by line during `crawl:verify`; the finished run is verification.json.
data/crawl/verification.partial.jsonl
# Search index over data/crawl/db/. A build product: `npm run build` (prebuild)
# regenerates it with scripts/build-crawl-index.ts.
data/crawl/index/
# SQLite export of data/crawl/db/ for ad-hoc queries. `npm run build-sqlite`
# rebuilds it; tracking it added ~24 MB to history on every rebuild.
data/crawl/superask-sites.db

.DS_Store
Thumbs.db
.vscode/
.idea/
.vercel
