# SuperAsk - environment template. Copy to .env.local and fill in.
# .env.local is gitignored. Never commit a real key (R-15, FR-74).

# ---------------------------------------------------------------------------
# Model provider (NFR-18). One of: gateway | sealion | anthropic | vllm | extractive
#   gateway    - Nous Research inference gateway, OpenAI-compatible. One key,
#                many model families. External hosting (NFR-11). Pilot default.
#   sealion    - AI Singapore SEA-LION, OpenAI-compatible API. Khmer-capable
#                Phase 0 candidate (R-13). External hosting (NFR-11).
#   anthropic  - Phase 0. Commercial API, external hosting (RD-01).
#   vllm       - Phase 1 target. Self-hosted Qwen behind an OpenAI-compatible
#                endpoint you host yourself (RD-02).
#   extractive - No model. Deterministic extraction from retrieved sources.
#                Used when no credential is present, and as the NFR-09
#                degradation path.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gateway

# --- gateway provider (Nous Research) ---------------------------------------
# Key from your Nous Research account (API keys page).
LLM_GATEWAY_API_KEY=
# Cheap, fast, Khmer-capable, supports temperature 0 and JSON mode.
LLM_GATEWAY_MODEL=google/gemini-3.1-flash-lite
LLM_GATEWAY_BASE_URL=https://inference-api.nousresearch.com/v1
# Request deadline in ms. Prefer a faster model over raising this (NFR-06).
LLM_GATEWAY_TIMEOUT_MS=30000
# Set to off if a model 400s on response_format.
LLM_GATEWAY_JSON_MODE=on

# --- sealion provider ------------------------------------------------------
# Key from https://playground.sea-lion.ai/ (API Key Manager).
SEALION_API_KEY=
SEALION_MODEL=aisingapore/Qwen-SEA-LION-v4.5-27B-IT
SEALION_BASE_URL=https://api.sea-lion.ai/v1
# Set to off if this model 400s on response_format.
SEALION_JSON_MODE=on
# Request deadline in ms.
# SEALION_TIMEOUT_MS=30000

# --- anthropic provider ----------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
# Set only when routing through a gateway or proxy rather than
# api.anthropic.com. A key that does not begin with `sk-ant-` needs this.
ANTHROPIC_BASE_URL=

# --- vllm provider (Phase 1) ----------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=qwen3-32b-instruct
VLLM_API_KEY=

# ---------------------------------------------------------------------------
# Thresholds. Governance-owned, not engineering discretion (section 12).
# ---------------------------------------------------------------------------
# Tier 1 curated-answer match confidence required to serve verbatim (FR-11).
CURATED_MATCH_THRESHOLD=0.72
# Minimum fused retrieval score to attempt generation. Below this: decline
# rather than guess (FR-16). Derived from the sweep printed by `npm run eval`.
RETRIEVAL_MIN_SCORE=0.20
# Share of the question's content words the top source must mention to count
# as "about" the question (R-07, lib/engine/topicality.ts).
# TOPICALITY_MIN_COVERAGE=0.34
# Below this topicality coverage, a crawled passage that covers more of the
# question may displace the approved source (lib/engine/tiers.ts).
# CRAWL_CHALLENGE_BELOW=0.75

# Unsourced fallback (lib/engine/fallback.ts). On by default: an in-scope
# question no source covers is answered from the model's own knowledge,
# labelled unverified. "false" is the strict PRD section 13 behaviour.
# GENERAL_FALLBACK_ENABLED=true
# Also allow that fallback for government-procedure questions. Off by default:
# SuperAsk does not invent fees, offices or deadlines.
# GENERAL_FALLBACK_FOR_SERVICES=false

# Build the knowledge-base indexes at server start (instrumentation.ts) rather
# than on the first request. Leave on; off only for debugging start-up.
KB_WARMUP=true

# --- API guard (lib/api/guard.ts) -------------------------------------------
# Requests per minute per client IP to /api/ask and /api/feedback, each.
# Generous because many citizens can share one carrier-NAT or school address.
RATE_LIMIT_PER_MINUTE=120
# Extra browser origins allowed to call the API (comma-separated). The site's
# own origin is always allowed.
ALLOWED_ORIGINS=

# Where audit and feedback records go: file (var/*.jsonl), stdout, or both.
# Default: stdout on Vercel (its filesystem loses files), file elsewhere.
AUDIT_LOG_SINK=

# Diagnostic view (FR-72/FR-73). Citizens must never see this.
# Closed pilot: SuperAsk team only.
DIAGNOSTICS_ENABLED=true
# Live process log: every gate, the payload sent to the model, and the reply.
# Prints to the server console and appends var/trace.jsonl. PII is redacted.
ASK_TRACE=true

# ---------------------------------------------------------------------------
# Telegram citizen channel (text bot → same /ask engine as the web UI).
# Create a bot with @BotFather, then:
#   npx tsx scripts/telegram-webhook.ts set https://<host>/api/telegram/webhook
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Random secret Telegram sends as X-Telegram-Bot-Api-Secret-Token.
# REQUIRED in production: without it the webhook refuses calls (503), because
# anyone could otherwise post fake updates. TELEGRAM_ALLOW_UNSIGNED=true
# overrides that, for a deployment that genuinely cannot set a secret.
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOW_UNSIGNED=false
# Mini App URL opened inside Telegram (defaults to <site>/chat).
TELEGRAM_MINI_APP_URL=https://<your-host>/chat
NEXT_PUBLIC_SITE_URL=https://<your-host>
# Channel links shown on the site (lib/ui/channels.ts).
NEXT_PUBLIC_TELEGRAM_BOT=superask168_bot
# NEXT_PUBLIC_MESSENGER_URL=https://m.me/<your-page-username>

# ---------------------------------------------------------------------------
# Facebook Messenger citizen channel (same /ask engine as web + Telegram).
# Create a Facebook Page + Meta app with the Messenger product, then:
#   1. Set the three secrets below in Vercel / .env.local
#   2. In Meta → Messenger → Webhooks, callback =
#        https://<host>/api/messenger/webhook
#      verify token = MESSENGER_VERIFY_TOKEN
#      subscribe to: messages, messaging_postbacks
# ---------------------------------------------------------------------------
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
# Any random string you invent; Meta asks for it when you save the webhook.
MESSENGER_VERIFY_TOKEN=
# MESSENGER_ALLOW_UNSIGNED=false

# Crawled official-website content as a labelled fallback when the approved
# corpus has no answer (lib/engine/crawl-answer.ts). "false" switches it off.
CRAWL_KB_ENABLED=true
# Minimum share of the question a crawled passage must cover to be served
# (lib/engine/crawl-topic.ts), for Latin-script and Khmer questions.
# CRAWL_MIN_COVERAGE=0.75
# CRAWL_MIN_COVERAGE_KM=0.6

# Live web search as the last sourced step (lib/engine/web-answer.ts). Off
# unless set to true AND a Tavily key is present. Results are labelled as web
# results and cited with links.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
# WEB_SEARCH_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Content monitoring crawler (scripts/crawl.ts). Set MONITOR_CONTACT before the
# first run: it goes in the User-Agent so a ministry operator can reach you.
# ---------------------------------------------------------------------------
# MONITOR_CONTACT=content-ops@localhost
# MONITOR_MIN_DELAY_MS=2000
# MONITOR_CONCURRENCY=6
# MONITOR_TIMEOUT_MS=20000
# MONITOR_MAX_BYTES=5242880
